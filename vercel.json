{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/css/(.*)", "destination": "/web/css/$1" },
    { "source": "/js/(.*)", "destination": "/web/js/$1" },
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/index.html", "destination": "/web/index.html" },
    { "source": "/admin.html", "destination": "/web/admin.html" },
    { "source": "/teacher.html", "destination": "/web/teacher.html" },
    { "source": "/student.html", "destination": "/web/student.html" },
    { "source": "/(.*)", "destination": "/web/$1" }
  ]
}
